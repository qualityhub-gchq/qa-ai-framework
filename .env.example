# Copy this file to .env and fill in values. NEVER commit .env.
# In GitHub Actions these come from Settings → Secrets and variables → Actions.

UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com

# Sauce Demo publishes its test password on its login page.
SAUCE_PASSWORD=secret_sauce

# Restful-Booker public demo credentials (documented on its site).
API_USERNAME=admin
API_PASSWORD=password123
