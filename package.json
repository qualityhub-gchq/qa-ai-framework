{
  "name": "qa-ai-framework",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted QA automation framework: Playwright + TypeScript + Claude Code agents + GitHub Actions",
  "scripts": {
    "test": "playwright test --project=ui --project=api",
    "test:generated": "playwright test --project=explorer",
    "snapshot": "node scripts/page-snapshot.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
